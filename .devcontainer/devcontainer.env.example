# Per-project git identity (+ optional HTTPS credentials) for the dev container.
#
# Copy this file to `devcontainer.env` (git-ignored) or run scripts/setup-identity.sh.
# Leave a value blank to fall back to your host git config. The dev container reads
# this on create (via .devcontainer/setup_git.sh) and applies it to the CONTAINER's
# own ~/.gitconfig — your host identity is never touched.

# --- Identity (commit attribution) ---
GIT_USER_NAME=
GIT_USER_EMAIL=

# Host used for SSH known_hosts / HTTPS credentials (default: github.com)
GIT_CREDENTIAL_HOST=github.com

# --- Credentials ---
# Recommended: SSH. Put a private key in .devcontainer/ssh/ (or generate one with
# scripts/setup-identity.sh) and register its public key as a repo Deploy Key.
#
# Alternative: HTTPS + Personal Access Token. Instead of an SSH key, uncomment and
# fill these; the token is stored in the container's ~/.git-credentials.
# GIT_CREDENTIAL_USERNAME=
# GIT_CREDENTIAL_TOKEN=
